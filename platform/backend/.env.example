# ==============================================================================
# SECURE VIDEO MANAGEMENT PLATFORM - PRODUCTION & DEVELOPMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, test, production)
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=SHADOW_VIDEO_VAULT

# Relational Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:SecureDbPass2025!@localhost:5432/video_management?schema=public"

# ══════════════════════════════════════════════════════════════════════════════
# CRYPTOGRAPHIC KEYS — MUST BE UNIQUE PER ENVIRONMENT
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use these placeholder values in production!
# ══════════════════════════════════════════════════════════════════════════════
JWT_ACCESS_SECRET="CHANGE_ME_GENERATE_64_CHAR_HEX_SECRET_1"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_64_CHAR_HEX_SECRET_2"
COOKIE_SECRET="CHANGE_ME_GENERATE_64_CHAR_HEX_SECRET_3"
STREAM_SIGNING_SECRET="CHANGE_ME_GENERATE_64_CHAR_HEX_SECRET_4"

# Access & Refresh Token Expirations
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION_DAYS=7
STREAM_TICKET_TTL_SECONDS=90

# Security & Brute-Force Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
UPLOAD_RATE_LIMIT_MAX_HOURLY=30

# File Upload Thresholds & Storage
MAX_VIDEO_SIZE_BYTES=2147483648 # 2GB
STORAGE_PROVIDER=local # local | s3
LOCAL_STORAGE_PATH="./uploads"

# S3 / Cloudflare R2 Compatible Storage (Optional)
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false

# CORS & Trusted Origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:4000"

# Initial Super Admin Seed (Used by seed script)
# Generate a strong password: node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
SUPER_ADMIN_NAME="Master Architect"
SUPER_ADMIN_EMAIL="admin@shadowvideo.io"
# SUPER_ADMIN_PASSWORD must be set manually — NEVER commit a real password here
SUPER_ADMIN_PASSWORD=""
