/index.html/admin/*    /admin/:splat    301!

# Netlify Serverless Function API Route (Handles /api/* on Netlify)
/api/*                 /.netlify/functions/api/:splat  200!

# Admin Panel SPA routes (React Vite Platform)
/admin/*               /admin/index.html   200
/admin                 /admin/index.html   200

# Standalone Security Operations Console (optional direct access)
/soc                   /admin.html         200

# Main Portfolio Website SPA fallback
